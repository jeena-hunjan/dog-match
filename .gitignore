# Data and experiment tracking (re-created by `make data` / training).
# data/splits/ is the exception: small, deterministic manifests (file names and labels only).
data/*
!data/splits/
mlruns/
mlartifacts/

# Model weights (published as GitHub Release assets instead)
*.pt
*.pth
*.onnx
*.safetensors
*.ckpt

# Images (dataset licences forbid committing them)
*.jpg
*.jpeg
*.png
*.gif
*.webp
*.bmp
# ...except the README's own figures (calibration plot, demo GIF, diagram)
!docs/images/*

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
