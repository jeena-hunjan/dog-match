# Copy to .env and fill in. Never commit .env.
# Local (make db-up):
#   DATABASE_URL=postgresql+psycopg://dogmatch:dogmatch@localhost:5432/dogmatch  # pragma: allowlist secret
# Neon: plain postgresql:// URLs are rewritten to the psycopg 3 driver; ?sslmode=require is kept.
# Run migrations against Neon's DIRECT (non-pooled) URL, not the -pooler host:
# PgBouncer in transaction mode does not play well with Alembic's DDL transaction.
DATABASE_URL=
LLM_API_KEY=
LLM_MODEL=
DOG_API_KEY=
MODEL_WEIGHTS_URL=
MODEL_WEIGHTS_SHA256=
ABSTAIN_THRESHOLD=
RATE_LIMIT_PER_MIN=
